{
    "version": 3,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ],
    "functions": {
        "api/(.*)": {
            "runtime": "nodejs18.x"
        }
    },
    "env": {
        "DATABASE_URL": "jdbc:mysql://localhost:3306/bookflight",
        "NODE_ENV": "development",
        "HOST_NAME": "localhost",
        "DB_HOST": "localhost",
        "DB_PORT": "3306",
        "DB_USER": "root",
        "DB_PASSWORD": "sa0Andsa0",
        "DB_NAME": "bookflight"
    },
    "build": {
        "env": {
            "NODE_ENV": "production"
        }
    },
    "dev": {
        "env": {
            "NODE_ENV": "development"
        }
    },
    "github": {
        "silent": true
    }
}